{
  "id": "opencode",
  "channel": "session-stdout",
  "stdout": "plain",
  "events": {
    "SessionStart": "session-start",
    "SessionEnd": "session-end"
  },
  "transcript_glob": "~/.local/share/opencode/**/*.jsonl",
  "install": "~/.config/opencode",
  "session_end": "native",
  "optional": false
}
