{
  "id": "claude-code",
  "channel": "session-stdout",
  "stdout": "plain",
  "events": {
    "SessionStart": "session-start",
    "UserPromptSubmit": "before-prompt",
    "Stop": "stop",
    "SessionEnd": "session-end"
  },
  "transcript_glob": "~/.claude/projects/**/*.jsonl",
  "install": "~/.claude",
  "session_end": "native",
  "optional": false
}
