{
  "$schema": "https://visualspec.dev/schema/1.0/schema.json",
  "visualSpec": "1.0",
  "metadata": {
    "title": "Example login surface",
    "language": "en",
    "status": "draft"
  },
  "profiles": ["ui"],
  "platforms": ["web"],
  "visualReferences": [
    {
      "id": "ref.login-frame",
      "kind": "image",
      "uri": ".overdrive/visual-sources/example-login/reference.png",
      "description": "Primary reference frame for layout and micro-detail extraction."
    }
  ],
  "tokens": {
    "color.surface": { "type": "color", "value": "#ffffff" },
    "color.ink": { "type": "color", "value": "#1a1d21" },
    "color.brand": { "type": "color", "value": "#2563eb" },
    "radius.card": { "type": "dimension", "value": "12px" }
  },
  "components": [
    {
      "id": "component.submit",
      "kind": "action.button",
      "name": "Submit",
      "states": ["default", "hover", "focus-visible", "pressed", "disabled"],
      "appearance": {
        "fill": "{color.brand}",
        "color": "#ffffff",
        "radius": 8
      },
      "accessibility": {
        "role": "button",
        "name": { "source": "content" },
        "keyboard": { "activate": ["Enter", "Space"] }
      }
    }
  ],
  "scenes": [
    {
      "id": "scene.login",
      "kind": "2d",
      "viewport": { "width": 390, "height": 844 },
      "layout": { "type": "column", "padding": 24, "gap": 16, "align": "stretch" },
      "nodes": [
        {
          "id": "node.card",
          "kind": "container",
          "appearance": { "fill": "{color.surface}", "radius": "{radius.card}" },
          "layout": { "type": "column", "padding": 20, "gap": 12 },
          "children": [
            {
              "id": "node.title",
              "kind": "text",
              "text": "Sign in",
              "appearance": {
                "color": "{color.ink}",
                "typography": {
                  "fontFamily": "Inter",
                  "fontSize": 22,
                  "fontWeight": 600,
                  "lineHeight": 1.2
                }
              }
            },
            {
              "id": "node.submit",
              "kind": "component",
              "componentRef": "component.submit",
              "text": "Continue"
            }
          ]
        }
      ]
    }
  ],
  "semantics": [
    {
      "id": "sem.title",
      "role": "heading",
      "name": { "source": "content", "value": "Sign in" },
      "nodeRef": "node.title"
    }
  ],
  "motion": [
    {
      "id": "motion.card-enter",
      "targets": ["node.card"],
      "essential": false,
      "timing": {
        "duration": { "value": 200, "unit": "ms" },
        "delay": { "value": 0, "unit": "ms" },
        "iterations": 1
      },
      "tracks": [
        {
          "property": "appearance.opacity",
          "from": 0,
          "to": 1
        }
      ]
    }
  ],
  "assets": [
    {
      "id": "asset.icon-tab-custom",
      "kind": "vector",
      "uri": ".overdrive/visual-sources/example-login/assets/icon-tab.svg",
      "extensions": {
        "overdrive.icon": {
          "iconKind": "custom-svg",
          "customized": true,
          "acquisition": "download"
        }
      }
    },
    {
      "id": "asset.icon-chevron",
      "kind": "symbol",
      "extensions": {
        "overdrive.icon": {
          "iconKind": "library-component",
          "customized": false,
          "library": "lucide",
          "iconName": "chevron-right",
          "acquisition": "consult"
        }
      }
    }
  ],
  "validation": {
    "rules": [
      {
        "id": "rule.title-typography",
        "targetRef": "node.title",
        "property": "appearance.typography.fontSize",
        "expected": 22,
        "tolerance": 0,
        "binding": true
      },
      {
        "id": "rule.card-radius",
        "targetRef": "node.card",
        "property": "appearance.radius",
        "expected": "12px",
        "binding": true
      }
    ]
  },
  "provenance": [
    {
      "path": "/tokens/color.brand",
      "method": "measured",
      "confidence": 0.95,
      "source": "ref.login-frame"
    }
  ],
  "rendering": {
    "targets": [
      {
        "id": "target.mobile",
        "platform": "web",
        "width": 390,
        "height": 844
      }
    ],
    "fallbackPolicy": "report-and-approximate"
  },
  "extensions": {
    "overdrive.classification": {
      "kind": "frontend-ui",
      "signals": ["form", "button", "card"],
      "confidence": "high"
    },
    "overdrive.fidelity": {
      "mode": "reference-exact",
      "designSystemChoice": {
        "askedUser": false,
        "method": "no-project-design-system"
      },
      "designSystemSpecPath": ".overdrive/visual-sources/example-login/design-system.visual-spec.json"
    },
    "overdrive.checklist": {
      "microDetailCategories": [
        "layout",
        "typography",
        "css",
        "motion",
        "navigation",
        "image",
        "icon",
        "interaction"
      ],
      "bindingRuleCount": 2
    }
  }
}
